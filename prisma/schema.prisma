generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
  INTERNAL
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ARCHIVED
  COMPLETED
  ON_HOLD
  AT_RISK
  CANCELLED
}

enum DocumentStatus {
  NOT_STARTED
  DRAFT
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  COMPLETED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  RESTORED
  ARCHIVED
  COMMENTED
  REVIEW_REQUESTED
  REVIEW_APPROVED
  EXPORTED
  IMPORTED
  STATUS_CHANGED
  ASSIGNED
}

// Task & Agile Enums
enum TaskType {
  EPIC
  FEATURE
  STORY
  TASK
  SUBTASK
  BUG
  IMPROVEMENT
  RESEARCH
  TECH_DEBT
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  TESTING
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DependencyType {
  BLOCKS
  BLOCKED_BY
  RELATES_TO
  DUPLICATES
}

// Product & Requirement Enums
enum RequirementType {
  BUSINESS
  FUNCTIONAL
  NON_FUNCTIONAL
}

enum FeatureStatus {
  PROPOSED
  UNDER_REVIEW
  PLANNED
  IN_DEVELOPMENT
  TESTING
  RELEASED
  DEPRECATED
}

// Milestone & Roadmap Enums
enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum RoadmapTimeframe {
  MONTHLY
  QUARTERLY
  ANNUAL
}

// Bug & QA Enums
enum BugSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum BugStatus {
  OPEN
  CONFIRMED
  IN_PROGRESS
  FIXED
  READY_FOR_TESTING
  VERIFIED
  REOPENED
  CLOSED
}

enum TestCaseStatus {
  PASSED
  FAILED
  BLOCKED
  SKIPPED
  NOT_RUN
}

// Release & Deployment Enums
enum ReleaseStatus {
  PLANNED
  IN_PROGRESS
  READY
  RELEASED
  ROLLED_BACK
}

enum EnvironmentType {
  DEVELOPMENT
  TESTING
  STAGING
  PRODUCTION
}

enum DeploymentStatus {
  PENDING
  DEPLOYING
  DEPLOYED
  FAILED
  ROLLED_BACK
}

// Risk Enums
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  IDENTIFIED
  MITIGATING
  ACCEPTED
  RESOLVED
  CLOSED
}

// Integration Provider
enum IntegrationProvider {
  GITHUB
  GITLAB
  BITBUCKET
  FIGMA
  SLACK
  TEAMS
  JIRA
  DATADOG
  SENTRY
  WEBHOOK
}

// ---------------------------------------------------------------------------
// IDENTITY & WORKSPACE
// ---------------------------------------------------------------------------

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  passwordHash         String
  name                 String
  avatarUrl            String?
  jobTitle             String?           @default("Software Engineer")
  department           String?           @default("Engineering")
  bio                  String?
  timezone             String?           @default("UTC")
  preferredLanguage    String?           @default("en")
  twoFactorEnabled     Boolean           @default(false)
  twoFactorSecret      String?
  twoFactorRecoveryCodes String?
  isEmailVerified      Boolean           @default(false)
  emailVerifyToken     String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  projectMemberships   ProjectMember[]
  createdProjects      Project[]         @relation("ProjectCreator")
  createdDocuments     Document[]        @relation("DocCreator")
  updatedDocuments     Document[]        @relation("DocModifier")
  documentVersions     DocumentVersion[] @relation("VersionAuthor")
  sessions             Session[]
  comments             Comment[]
  reviewRequests       ReviewRequest[]   @relation("ReviewRequester")
  reviewApprovals      ReviewApproval[]  @relation("Reviewer")
  activityLogs         ActivityLog[]
  notifications        Notification[]
  createdTemplates     Template[]

  // New Relations
  assignedTasks        Task[]            @relation("TaskAssignee")
  reportedTasks        Task[]            @relation("TaskReporter")
  timeEntries          TimeEntry[]
  reportedBugs         Bug[]             @relation("BugReporter")
  assignedBugs         Bug[]             @relation("BugAssignee")
  assignedTestCases    TestCase[]        @relation("TestCaseTester")
  discussions          Discussion[]
  discussionComments   DiscussionComment[]
  ownedFeatures        Feature[]         @relation("FeatureOwner")
  ownedMilestones      Milestone[]       @relation("MilestoneOwner")
  ownedRisks           Risk[]            @relation("RiskOwner")
  deployments          Deployment[]      @relation("DeploymentDeployer")
  auditEvents          AuditEvent[]
  managedPortfolios    Portfolio[]       @relation("PortfolioManager")
  createdCalendarEvents CalendarEvent[]  @relation("CalendarEventCreator")
  ownedReleases        Release[]         @relation("ReleaseOwner")
  releaseApprovals     ReleaseApproval[] @relation("ReleaseApprover")
  rollbackRequests     RollbackRecord[]  @relation("RollbackRequester")
  authoredRFCs         RFC[]             @relation("RFCAuthor")
  rfcReviews           RFCReview[]
  rfcVotes             RFCVote[]
  approvedDecisions    ArchitectureDecision[] @relation("DecisionApprover")
  uploadedFiles        FileItem[]        @relation("FileUploader")
  uploadedFileVersions FileVersion[]     @relation("FileVersionUploader")
  fileAttachments      FileAttachment[]  @relation("FileAttacher")
  sentWorkspaceInvitations WorkspaceInvitation[] @relation("WorkspaceInviter")
  mitigations          RiskMitigation[]  @relation("MitigationOwner")
  riskHistories        RiskHistory[]     @relation("RiskHistoryActor")
  riskComments         RiskComment[]     @relation("RiskCommentAuthor")
  ownedDependencies    ProjectDependency[] @relation("DependencyOwner")

  @@index([email])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members      WorkspaceMember[]
  projects     Project[]
  templates    Template[]
  tags         Tag[]
  activityLogs ActivityLog[]
  settings     WorkspaceSetting?

  // Enterprise additions
  portfolios   Portfolio[]
  timeEntries  TimeEntry[]
  taskLabels   TaskLabel[]
  integrations Integration[]
  auditEvents  AuditEvent[]
  calendarEvents CalendarEvent[]
  folders      FileFolder[]
  files        FileItem[]
  rfcs         RFC[]
  architectureDecisions ArchitectureDecision[]
  invitations  WorkspaceInvitation[]
  dependencies ProjectDependency[]

  @@index([ownerId])
  @@index([slug])
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        UserRole  @default(EDITOR)
  status      String    @default("ACTIVE") // ACTIVE, SUSPENDED
  title       String?
  department  String?
  joinedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// PORTFOLIO MANAGEMENT
// ---------------------------------------------------------------------------

model Portfolio {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  slug        String
  description String?
  category    String    @default("Strategic Initiatives")
  budget      Float     @default(0.0)
  status      String    @default("ACTIVE")
  health      String    @default("ON_TRACK")
  color       String    @default("#4f46e5")
  managerId   String?
  startDate   DateTime?
  targetDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  manager    User?                @relation("PortfolioManager", fields: [managerId], references: [id], onDelete: SetNull)
  projects   Project[]
  objectives PortfolioObjective[]
  milestones Milestone[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model PortfolioObjective {
  id          String    @id @default(uuid())
  portfolioId String
  title       String
  description String?
  targetDate  DateTime?
  progress    Int       @default(0)
  status      String    @default("IN_PROGRESS")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

// ---------------------------------------------------------------------------
// PROJECT MANAGEMENT
// ---------------------------------------------------------------------------

model Project {
  id            String            @id @default(uuid())
  workspaceId   String
  portfolioId   String?
  name          String
  slug          String
  projectKey    String            @default("PRJ") // e.g. "FPO" for FPO-101
  description   String?
  projectType   String            @default("Web application")
  category      String            @default("Engineering")
  techStack     String            @default("[]")
  repositoryUrl String?
  icon          String?           @default("folder")
  color         String?           @default("#4f46e5")
  visibility    ProjectVisibility @default(PRIVATE)
  status        ProjectStatus     @default(ACTIVE)
  priority      String            @default("MEDIUM")
  startDate     DateTime?
  targetDate    DateTime?
  budget        Float?            @default(0.0)
  goals         String?           @default("[]")
  createdById   String
  isArchived    Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  portfolio    Portfolio?      @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  createdBy    User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  categories   Category[]
  documents    Document[]
  members      ProjectMember[]
  activityLogs ActivityLog[]

  // SDLC relations
  products       Product[]
  features       Feature[]
  requirements   Requirement[]
  userStories    UserStory[]
  tasks          Task[]
  sprints        Sprint[]
  boards         Board[]
  milestones     Milestone[]
  roadmaps       Roadmap[]
  designItems    DesignItem[]
  repositories   Repository[]
  codeReferences CodeReference[]
  bugs           Bug[]
  testPlans      TestPlan[]
  releases       Release[]
  timeEntries    TimeEntry[]
  discussions    Discussion[]
  risks          Risk[]
  calendarEvents CalendarEvent[]
  designTokens   DesignToken[]
  colorPalettes  ColorPalette[]
  themes         Theme[]
  componentSpecs ComponentSpecification[]
  tokenVersions  TokenVersion[]
  pullRequests   PullRequest[]
  pipelineRuns   PipelineRun[]
  testRuns       TestRun[]
  folders        FileFolder[]
  files          FileItem[]
  rfcs           RFC[]
  architectureDecisions ArchitectureDecision[]
  sourceDependencies ProjectDependency[] @relation("SourceProjectDependencies")
  targetDependencies ProjectDependency[] @relation("TargetProjectDependencies")

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([portfolioId])
  @@index([status])
  @@index([isArchived])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      UserRole @default(EDITOR)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// PRODUCT MANAGEMENT
// ---------------------------------------------------------------------------

model Product {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  vision      String?
  strategy    String?
  targetAudience String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  features Feature[]

  @@index([projectId])
}

model Feature {
  id            String        @id @default(uuid())
  projectId     String
  productId     String?
  title         String
  description   String?
  businessValue String        @default("High")
  priority      TaskPriority  @default(MEDIUM)
  status        FeatureStatus @default(PROPOSED)
  ownerId       String?
  targetRelease String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  owner        User?         @relation("FeatureOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  requirements Requirement[]
  userStories  UserStory[]
  tasks        Task[]
  testCases    TestCase[]

  @@index([projectId])
  @@index([productId])
  @@index([status])
}

model Requirement {
  id                 String          @id @default(uuid())
  projectId          String
  featureId          String?
  title              String
  type               RequirementType @default(FUNCTIONAL)
  description        String
  acceptanceCriteria String?
  priority           TaskPriority    @default(MEDIUM)
  status             String          @default("ACTIVE")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feature Feature? @relation(fields: [featureId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([featureId])
}

model UserStory {
  id                 String       @id @default(uuid())
  projectId          String
  featureId          String?
  title              String
  asA                String       @default("user")
  iWant              String
  soThat             String
  acceptanceCriteria String?
  storyPoints        Int          @default(3)
  priority           TaskPriority @default(MEDIUM)
  status             TaskStatus   @default(TODO)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feature Feature? @relation(fields: [featureId], references: [id], onDelete: SetNull)
  tasks   Task[]

  @@index([projectId])
  @@index([featureId])
}

// ---------------------------------------------------------------------------
// TASK MANAGEMENT & AGILE
// ---------------------------------------------------------------------------

model Task {
  id             String       @id @default(uuid())
  projectId      String
  taskIdentifier String       // e.g. "FPO-101"
  title          String
  description    String?
  taskType       TaskType     @default(TASK)
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  parentTaskId   String?
  assigneeId     String?
  reporterId     String?
  sprintId       String?
  milestoneId    String?
  featureId      String?
  userStoryId    String?
  documentId     String?
  startDate      DateTime?
  dueDate        DateTime?
  estimatedHours Float?       @default(0.0)
  actualHours    Float?       @default(0.0)
  storyPoints    Int?         @default(1)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask       Task?                  @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks         Task[]                 @relation("SubTasks")
  assignee         User?                  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter         User?                  @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  sprint           Sprint?                @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  milestone        Milestone?             @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  feature          Feature?               @relation(fields: [featureId], references: [id], onDelete: SetNull)
  userStory        UserStory?             @relation(fields: [userStoryId], references: [id], onDelete: SetNull)
  document         Document?              @relation(fields: [documentId], references: [id], onDelete: SetNull)

  dependencies     TaskDependency[]       @relation("TaskDependencies")
  dependedOnBy     TaskDependency[]       @relation("TaskDependedOn")
  labelAssignments TaskLabelAssignment[]
  timeEntries      TimeEntry[]
  codeReferences   CodeReference[]
  bugs             Bug[]
  calendarEvents   CalendarEvent[]
  pullRequests     PullRequest[]
  releaseTasks     ReleaseTask[]
  testCases        TestCase[]

  @@unique([projectId, taskIdentifier])
  @@index([projectId])
  @@index([status])
  @@index([assigneeId])
  @@index([sprintId])
  @@index([milestoneId])
}

model TaskDependency {
  id               String         @id @default(uuid())
  taskId           String
  dependsOnTaskId  String
  dependencyType   DependencyType @default(BLOCKS)
  createdAt        DateTime       @default(now())

  task             Task           @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask    Task           @relation("TaskDependedOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
}

model TaskLabel {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments TaskLabelAssignment[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model TaskLabelAssignment {
  id      String @id @default(uuid())
  taskId  String
  labelId String

  task    Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   TaskLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([taskId, labelId])
  @@index([taskId])
  @@index([labelId])
}

model Sprint {
  id             String       @id @default(uuid())
  projectId      String
  name           String
  goal           String?
  status         SprintStatus @default(PLANNED)
  startDate      DateTime?
  endDate        DateTime?
  capacityPoints           Int          @default(40)
  velocity                 Int?         @default(0)
  retrospectiveWentWell    String?
  retrospectiveWentWrong   String?
  retrospectiveActionItems String?
  createdAt                DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
  calendarEvents CalendarEvent[]
  releases Release[]

  @@index([projectId])
  @@index([status])
}

model Board {
  id        String   @id @default(uuid())
  projectId String
  name      String   @default("Kanban Board")
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns BoardColumn[]

  @@index([projectId])
}

model BoardColumn {
  id          String     @id @default(uuid())
  boardId     String
  name        String
  statusValue TaskStatus
  wipLimit    Int?       @default(0)
  sortOrder   Int        @default(0)

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

// ---------------------------------------------------------------------------
// ROADMAP & MILESTONES
// ---------------------------------------------------------------------------

model Milestone {
  id                   String          @id @default(uuid())
  projectId            String
  portfolioId          String?
  roadmapId            String?
  name                 String
  description          String?
  ownerId              String?
  startDate            DateTime?
  targetDate           DateTime?
  priority             String          @default("MEDIUM")
  status               MilestoneStatus @default(PLANNED)
  completionPercentage Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  portfolio      Portfolio?      @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  roadmap        Roadmap?        @relation(fields: [roadmapId], references: [id], onDelete: SetNull)
  owner          User?           @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks          Task[]
  roadmapItems   RoadmapItem[]
  calendarEvents CalendarEvent[]
  releases       Release[]

  @@index([projectId])
  @@index([portfolioId])
  @@index([roadmapId])
}

model Roadmap {
  id        String           @id @default(uuid())
  projectId String
  name      String
  timeframe RoadmapTimeframe @default(QUARTERLY)
  status    String           @default("ACTIVE")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items      RoadmapItem[]
  milestones Milestone[]

  @@index([projectId])
}

model RoadmapItem {
  id          String     @id @default(uuid())
  roadmapId   String
  milestoneId String?
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  progress    Int        @default(0)
  color       String     @default("#3b82f6")
  status      String     @default("PLANNED")
  priority    String     @default("MEDIUM")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  roadmap   Roadmap    @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([roadmapId])
  @@index([milestoneId])
}

// ---------------------------------------------------------------------------
// DESIGN MANAGEMENT & DESIGN TOKENS
// ---------------------------------------------------------------------------

model DesignItem {
  id          String   @id @default(uuid())
  projectId   String
  title       String
  description String?
  category    String   @default("COMPONENTS") // TOKENS, SYSTEM, COMPONENTS, ASSETS, SPECS
  figmaUrl    String?
  version     String   @default("1.0.0")
  status      String   @default("APPROVED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model DesignToken {
  id           String        @id @default(uuid())
  projectId    String
  name         String
  key          String        // e.g. "colors.brand.primary"
  category     String        // BRAND_COLOR, SEMANTIC_COLOR, BG_COLOR, SURFACE_COLOR, TYPOGRAPHY, FONT_FAMILY, FONT_SIZE, FONT_WEIGHT, LINE_HEIGHT, LETTER_SPACING, SPACING, GRID, BORDER_RADIUS, BORDER_WIDTH, SHADOW, ICONOGRAPHY, ANIMATION, TRANSITION, BREAKPOINT, Z_INDEX
  value        String
  type         String        @default("color")
  description  String?
  semanticRole String?       // PRIMARY, SECONDARY, SUCCESS, WARNING, DANGER, INFO, NEUTRAL, BACKGROUND, SURFACE, BORDER, TEXT
  paletteId    String?
  metadata     String?       @default("{}") // JSON string for hex, rgb, hsl, preview details
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  palette ColorPalette? @relation(fields: [paletteId], references: [id], onDelete: SetNull)

  @@unique([projectId, key])
  @@index([projectId])
  @@index([category])
}

model ColorPalette {
  id          String        @id @default(uuid())
  projectId   String
  name        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tokens  DesignToken[]

  @@index([projectId])
}

model Theme {
  id             String   @id @default(uuid())
  projectId      String
  name           String
  slug           String
  isDefault      Boolean  @default(false)
  isDark         Boolean  @default(false)
  isPublished    Boolean  @default(true)
  version        String   @default("1.0.0")
  tokenOverrides String   @default("{}") // JSON map of key -> value overrides
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@index([projectId])
}

model ComponentSpecification {
  id            String   @id @default(uuid())
  projectId     String
  name          String
  componentType String   @default("BUTTON") // BUTTON, INPUT, FORM, CARD, TABLE, MODAL, DRAWER, NAVIGATION, ALERT, BADGE, LAYOUT
  category      String   @default("COMPONENTS")
  description   String?
  status        String   @default("STABLE") // DRAFT, REVIEW, STABLE, DEPRECATED
  variants      String   @default("[]") // JSON string
  properties    String   @default("[]") // JSON string
  accessibility String?
  usageExamples String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([componentType])
}

model TokenVersion {
  id            String   @id @default(uuid())
  projectId     String
  versionNumber String   @default("1.0.0")
  notes         String?
  snapshot      String   // JSON snapshot of tokens and themes
  publishedById String?
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// DEVELOPMENT & REPOSITORY MANAGEMENT
// ---------------------------------------------------------------------------

model Repository {
  id            String    @id @default(uuid())
  projectId     String
  name          String
  url           String
  defaultBranch String    @default("main")
  provider      String    @default("GITHUB") // GITHUB, GITLAB, BITBUCKET
  isConnected   Boolean   @default(true)
  isPrimary     Boolean   @default(false)
  visibility    String    @default("PUBLIC") // PUBLIC, PRIVATE, INTERNAL
  owner         String?
  lastSyncAt    DateTime?
  syncStatus    String?   @default("SYNCED") // SYNCED, DISCONNECTED, ERROR
  webhookUrl    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branches     RepositoryBranch[]
  commits      GitCommit[]
  pullRequests PullRequest[]
  pipelineRuns PipelineRun[]

  @@index([projectId])
}

model RepositoryBranch {
  id                String   @id @default(uuid())
  repositoryId      String
  name              String
  isDefault         Boolean  @default(false)
  lastCommitSha     String?
  lastCommitMessage String?
  lastCommitAuthor  String?
  updatedAt         DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, name])
  @@index([repositoryId])
}

model GitCommit {
  id           String   @id @default(uuid())
  repositoryId String
  sha          String
  message      String
  authorName   String
  authorEmail  String?
  authorAvatar String?
  branch       String   @default("main")
  additions    Int      @default(0)
  deletions    Int      @default(0)
  committedAt  DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, sha])
  @@index([repositoryId])
}

model PullRequest {
  id           String    @id @default(uuid())
  repositoryId String
  projectId    String
  taskId       String?
  prNumber     Int
  title        String
  description  String?
  author       String
  authorAvatar String?
  sourceBranch String
  targetBranch String    @default("main")
  status       String    @default("OPEN") // OPEN, MERGED, CLOSED
  reviewStatus String    @default("PENDING") // PENDING, APPROVED, CHANGES_REQUESTED
  url          String?
  createdAt    DateTime  @default(now())
  mergedAt     DateTime?

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([repositoryId, prNumber])
  @@index([projectId])
  @@index([repositoryId])
  @@index([taskId])
}

model PipelineRun {
  id               String    @id @default(uuid())
  repositoryId     String
  projectId        String
  pipelineNumber   Int
  workflowName     String
  provider         String    @default("GITHUB_ACTIONS") // GITHUB_ACTIONS, GITLAB_CI, BITBUCKET_PIPELINES
  status           String    @default("SUCCESS") // SUCCESS, FAILED, RUNNING, QUEUED, CANCELLED
  branch           String
  commitSha        String
  commitMessage    String?
  durationSeconds  Int       @default(0)
  testsPassed      Int       @default(0)
  testsFailed      Int       @default(0)
  testsTotal       Int       @default(0)
  deploymentStatus String?
  url              String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([repositoryId])
}

model CodeReference {
  id            String   @id @default(uuid())
  projectId     String
  taskId        String?
  title         String
  refType       String   // PULL_REQUEST, BRANCH, COMMIT
  refIdentifier String   // e.g. "PR #42", "feat/pci-dss", "c7a8b9e"
  url           String?
  status        String   @default("MERGED")
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// ISSUE & BUG TRACKING
// ---------------------------------------------------------------------------

model Bug {
  id                 String       @id @default(uuid())
  projectId          String
  taskId             String?
  bugIdentifier      String       // e.g. "BUG-101"
  title              String
  description        String
  severity           BugSeverity  @default(MEDIUM)
  priority           TaskPriority @default(MEDIUM)
  status             BugStatus    @default(OPEN)
  environment        String?      @default("Staging")
  browser            String?      @default("Chrome 122")
  device             String?      @default("Desktop macOS")
  stepsToReproduce   String?
  expectedResult     String?
  actualResult       String?
  rootCause          String?
  resolutionNotes    String?
  reporterId         String
  assigneeId         String?
  relatedReleaseId   String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reporter       User        @relation("BugReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee       User?       @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  relatedRelease Release?    @relation(fields: [relatedReleaseId], references: [id], onDelete: SetNull)
  testCases      TestCase[]

  @@unique([projectId, bugIdentifier])
  @@index([projectId])
  @@index([status])
  @@index([severity])
}

// ---------------------------------------------------------------------------
// TESTING & QUALITY ASSURANCE
// ---------------------------------------------------------------------------

model TestPlan {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testSuites TestSuite[]
  executions TestExecution[]

  @@index([projectId])
}

model TestSuite {
  id          String     @id @default(uuid())
  testPlanId  String
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  testPlan  TestPlan   @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  testCases TestCase[]
  testRuns  TestRun[]

  @@index([testPlanId])
}

model TestCase {
  id               String           @id @default(uuid())
  testSuiteId      String
  caseIdentifier   String           // e.g. "TC-001"
  title            String
  description      String?
  testType         String           @default("INTEGRATION") // UNIT, INTEGRATION, FUNCTIONAL, REGRESSION, SMOKE, SANITY, API, UI, E2E, PERFORMANCE, SECURITY, ACCESSIBILITY, ACCEPTANCE
  environment      String?          @default("Staging")
  preconditions    String?
  steps            String
  expectedResult   String
  actualResult     String?
  status           TestCaseStatus   @default(NOT_RUN)
  priority         TaskPriority     @default(MEDIUM)
  assignedTesterId String?
  featureId        String?
  bugId            String?
  taskId           String?
  releaseId        String?
  executionHistory String?          @default("[]")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  testSuite      TestSuite        @relation(fields: [testSuiteId], references: [id], onDelete: Cascade)
  assignedTester User?            @relation("TestCaseTester", fields: [assignedTesterId], references: [id], onDelete: SetNull)
  feature        Feature?         @relation(fields: [featureId], references: [id], onDelete: SetNull)
  bug            Bug?             @relation(fields: [bugId], references: [id], onDelete: SetNull)
  task           Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  release        Release?         @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  attachments    TestAttachment[]

  @@index([testSuiteId])
  @@index([status])
  @@index([taskId])
  @@index([releaseId])
}

model TestRun {
  id           String    @id @default(uuid())
  projectId    String
  testSuiteId  String?
  releaseId    String?
  name         String
  environment  String    @default("Staging")
  status       String    @default("COMPLETED") // IN_PROGRESS, COMPLETED, ABORTED
  executedById String?
  totalCases   Int       @default(0)
  passedCases  Int       @default(0)
  failedCases  Int       @default(0)
  blockedCases Int       @default(0)
  skippedCases Int       @default(0)
  passRate     Float     @default(0.0)
  notes        String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testSuite TestSuite? @relation(fields: [testSuiteId], references: [id], onDelete: SetNull)
  release   Release?   @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([testSuiteId])
  @@index([releaseId])
}

model TestAttachment {
  id         String   @id @default(uuid())
  testCaseId String
  fileName   String
  fileUrl    String
  fileSize   Int      @default(0)
  mimeType   String   @default("image/png")
  createdAt  DateTime @default(now())

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
}

model TestExecution {
  id           String   @id @default(uuid())
  testPlanId   String
  executedById String
  passedCount  Int      @default(0)
  failedCount  Int      @default(0)
  blockedCount Int      @default(0)
  notes        String?
  executedAt   DateTime @default(now())

  testPlan TestPlan @relation(fields: [testPlanId], references: [id], onDelete: Cascade)

  @@index([testPlanId])
}

// ---------------------------------------------------------------------------
// RELEASE & DEPLOYMENT MANAGEMENT
// ---------------------------------------------------------------------------

model Release {
  id             String            @id @default(uuid())
  projectId      String
  version        String            // e.g. "v1.2.0"
  title          String
  description    String?
  status         ReleaseStatus     @default(PLANNED)
  targetDate     DateTime?
  releasedAt     DateTime?
  releaseNotes   String?
  checklistItems String            @default("[]") // JSON string of checklist items
  sprintId       String?
  milestoneId    String?
  ownerId        String?
  environment    String            @default("PRODUCTION") // DEVELOPMENT, TESTING, QA, STAGING, PRODUCTION
  readinessScore Float             @default(0.0)
  rollbackPlan   String?
  isArchived     Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint         Sprint?           @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  milestone      Milestone?        @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  owner          User?             @relation("ReleaseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deployments    Deployment[]
  bugs           Bug[]
  calendarEvents CalendarEvent[]
  tasks          ReleaseTask[]
  approvals      ReleaseApproval[]
  rollbacks      RollbackRecord[]
  testRuns       TestRun[]
  testCases      TestCase[]

  @@unique([projectId, version])
  @@index([projectId])
  @@index([status])
  @@index([sprintId])
  @@index([milestoneId])
}

model ReleaseTask {
  id        String   @id @default(uuid())
  releaseId String
  taskId    String
  createdAt DateTime @default(now())

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([releaseId, taskId])
  @@index([releaseId])
  @@index([taskId])
}

model ReleaseApproval {
  id         String    @id @default(uuid())
  releaseId  String
  approverId String
  role       String    @default("RELEASE_MANAGER") // QA_LEAD, SECURITY_LEAD, RELEASE_MANAGER, PRODUCT_OWNER
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  notes      String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  release  Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  approver User    @relation("ReleaseApprover", fields: [approverId], references: [id], onDelete: Cascade)

  @@index([releaseId])
  @@index([approverId])
}

model Deployment {
  id                   String           @id @default(uuid())
  releaseId            String
  environment          EnvironmentType  @default(STAGING)
  status               DeploymentStatus @default(DEPLOYED)
  deployedById         String
  buildNumber          String?
  commitSha            String?
  durationSeconds      Int?             @default(45)
  logs                 String?
  failureReason        String?
  previousDeploymentId String?
  startedAt            DateTime         @default(now())
  completedAt          DateTime?
  deployedAt           DateTime         @default(now())
  rollbackReason       String?

  release    Release          @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  deployedBy User             @relation("DeploymentDeployer", fields: [deployedById], references: [id], onDelete: Restrict)
  rollbacks  RollbackRecord[]

  @@index([releaseId])
  @@index([deployedById])
}

model RollbackRecord {
  id            String      @id @default(uuid())
  releaseId     String
  deploymentId  String?
  requestedById String
  targetVersion String
  reason        String
  status        String      @default("COMPLETED") // REQUESTED, APPROVED, IN_PROGRESS, COMPLETED, FAILED
  logs          String?
  executedAt    DateTime    @default(now())

  release     Release     @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  deployment  Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  requestedBy User        @relation("RollbackRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([releaseId])
  @@index([deploymentId])
}

// ---------------------------------------------------------------------------
// TIME TRACKING
// ---------------------------------------------------------------------------

model TimeEntry {
  id          String   @id @default(uuid())
  workspaceId String
  projectId   String
  taskId      String?
  userId      String
  hours       Float
  date        DateTime @default(now())
  description String?
  isBillable  Boolean  @default(true)
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([projectId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// COLLABORATION: DISCUSSIONS
// ---------------------------------------------------------------------------

model Discussion {
  id           String   @id @default(uuid())
  projectId    String?
  workspaceId  String?
  authorId     String
  title        String
  content      String
  category     String   @default("ARCHITECTURE") // ARCHITECTURE, TECHNICAL_DESIGN, DATABASE_DESIGN, API_DESIGN, SECURITY, PERFORMANCE, INFRASTRUCTURE, CODE_REVIEW, PRODUCT_DECISIONS, ENGINEERING_STANDARDS, GENERAL_DISCUSSION
  status       String   @default("OPEN") // OPEN, IN_DISCUSSION, AWAITING_REVIEW, DECISION_MADE, REJECTED, ARCHIVED
  priority     String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  tags         String?  // JSON array string e.g. ["p0", "consensus"]
  isPinned     Boolean  @default(false)
  isResolved   Boolean  @default(false)
  resolvedAt   DateTime?
  resolvedById String?
  documentId   String?
  taskId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project  Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments DiscussionComment[]

  @@index([projectId])
  @@index([workspaceId])
  @@index([category])
  @@index([status])
}

model DiscussionComment {
  id           String   @id @default(uuid())
  discussionId String
  authorId     String
  parentId     String?
  content      String
  isEdited     Boolean  @default(false)
  isPinned     Boolean  @default(false)
  reactions    String?  // JSON object e.g. {"👍": ["userId1", "userId2"]}
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  discussion Discussion          @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author     User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     DiscussionComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    DiscussionComment[] @relation("CommentReplies")

  @@index([discussionId])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// RISK & DEPENDENCY MANAGEMENT
// ---------------------------------------------------------------------------

model Risk {
  id              String           @id @default(uuid())
  projectId       String
  workspaceId     String?
  title           String
  description     String
  category        String           @default("Compliance & Security")
  probability     RiskLevel        @default(MEDIUM)
  impact          RiskLevel        @default(HIGH)
  severity        RiskLevel        @default(HIGH)
  score           Int              @default(6)
  priority        String           @default("HIGH")
  riskOwnerId     String?
  mitigationPlan  String?
  contingencyPlan String?
  status          RiskStatus       @default(IDENTIFIED)
  targetDate      DateTime?
  resolvedDate    DateTime?
  relatedTaskId   String?
  relatedBugId    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User?            @relation("RiskOwner", fields: [riskOwnerId], references: [id], onDelete: SetNull)
  mitigations RiskMitigation[]
  history     RiskHistory[]
  comments    RiskComment[]

  @@index([projectId])
  @@index([workspaceId])
  @@index([status])
}

model RiskMitigation {
  id          String    @id @default(uuid())
  riskId      String
  description String
  ownerId     String?
  startDate   DateTime?
  dueDate     DateTime?
  status      String    @default("IN_PROGRESS") // PLANNED, IN_PROGRESS, COMPLETED, OVERDUE
  progress    Int       @default(0) // 0-100
  completedAt DateTime?
  evidence    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  risk  Risk  @relation(fields: [riskId], references: [id], onDelete: Cascade)
  owner User? @relation("MitigationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([riskId])
  @@index([ownerId])
}

model RiskHistory {
  id             String   @id @default(uuid())
  riskId         String
  previousStatus String
  newStatus      String
  changedById    String
  changedAt      DateTime @default(now())
  reason         String?

  risk      Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  changedBy User @relation("RiskHistoryActor", fields: [changedById], references: [id], onDelete: Cascade)

  @@index([riskId])
  @@index([changedById])
}

model RiskComment {
  id        String   @id @default(uuid())
  riskId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  risk   Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  author User @relation("RiskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([riskId])
  @@index([authorId])
}

model ProjectDependency {
  id               String    @id @default(uuid())
  workspaceId      String
  projectId        String?
  title            String
  description      String?
  sourceProjectId  String?
  targetProjectId  String?
  sourceTaskId     String?
  targetTaskId     String?
  ownerId          String?
  dependencyType   String    @default("TECHNICAL") // TASK_TO_TASK, PROJECT_TO_PROJECT, TEAM_TO_TEAM, TECHNICAL, EXTERNAL, INFRASTRUCTURE, RELEASE
  priority         String    @default("MEDIUM")    // LOW, MEDIUM, HIGH, CRITICAL
  status           String    @default("IDENTIFIED")// IDENTIFIED, PENDING, IN_PROGRESS, BLOCKED, RESOLVED, CANCELLED
  dueDate          DateTime?
  resolutionNotes  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceProject Project?  @relation("SourceProjectDependencies", fields: [sourceProjectId], references: [id], onDelete: SetNull)
  targetProject Project?  @relation("TargetProjectDependencies", fields: [targetProjectId], references: [id], onDelete: SetNull)
  owner         User?     @relation("DependencyOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([sourceProjectId])
  @@index([targetProjectId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// INTEGRATIONS & AUDIT
// ---------------------------------------------------------------------------

model Integration {
  id          String              @id @default(uuid())
  workspaceId String
  provider    IntegrationProvider
  name        String
  isConnected Boolean             @default(true)
  config      String              @default("{}") // JSON settings
  syncStatus  String              @default("SYNCED")
  lastSyncAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

model AuditEvent {
  id          String   @id @default(uuid())
  workspaceId String
  projectId   String?
  userId      String?
  actorName   String?
  action      String
  category    String   @default("SYSTEM")
  status      String   @default("SUCCESS") // SUCCESS, FAILED
  entityType  String
  entityId    String?
  details     String?  @default("{}")
  ipAddress   String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([projectId])
  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// EXISTING DOCUMENTATION & TEMPLATES (PRESERVED IN FULL)
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid())
  projectId   String
  parentId    String?
  name        String
  slug        String
  description String?
  sortOrder   Int      @default(0)
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Category?  @relation("NestedCategories", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("NestedCategories")
  documents Document[]

  @@index([projectId])
  @@index([parentId])
  @@index([projectId, sortOrder])
}

model Document {
  id            String         @id @default(uuid())
  projectId     String
  categoryId    String
  title         String
  fileName      String
  slug          String
  description   String?
  content       String         @default("")
  status        DocumentStatus @default(NOT_STARTED)
  isOptional    Boolean        @default(false)
  sortOrder     Int            @default(0)
  versionNumber Int            @default(1)
  createdById   String
  updatedById   String?
  isArchived    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category       Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy      User              @relation("DocCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User?             @relation("DocModifier", fields: [updatedById], references: [id], onDelete: SetNull)
  versions       DocumentVersion[]
  comments       Comment[]
  reviewRequests ReviewRequest[]
  documentTags   DocumentTag[]
  activityLogs   ActivityLog[]
  tasks          Task[]

  @@index([projectId])
  @@index([categoryId])
  @@index([status])
  @@index([isArchived])
  @@index([projectId, sortOrder])
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String
  versionNumber Int
  title         String
  content       String
  changeSummary String?
  authorId      String
  createdAt     DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User     @relation("VersionAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

model Template {
  id                  String   @id @default(uuid())
  workspaceId         String?
  createdById         String?
  title               String
  slug                String
  description         String
  category            String
  purpose             String
  recommendedSections String   @default("[]")
  content             String
  isBuiltin           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([category])
  @@index([isBuiltin])
}

model Comment {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  parentId   String?
  content    String
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("ThreadedComments", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("ThreadedComments")

  @@index([documentId])
  @@index([userId])
  @@index([parentId])
}

model ReviewRequest {
  id          String       @id @default(uuid())
  documentId  String
  requesterId String
  status      ReviewStatus @default(PENDING)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  document  Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requester User             @relation("ReviewRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  approvals ReviewApproval[]

  @@index([documentId])
  @@index([requesterId])
  @@index([status])
}

model ReviewApproval {
  id              String       @id @default(uuid())
  reviewRequestId String
  reviewerId      String
  status          ReviewStatus @default(APPROVED)
  comment         String?
  createdAt       DateTime     @default(now())

  reviewRequest ReviewRequest @relation(fields: [reviewRequestId], references: [id], onDelete: Cascade)
  reviewer      User          @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([reviewRequestId, reviewerId])
  @@index([reviewRequestId])
  @@index([reviewerId])
}

model Tag {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentTags DocumentTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model DocumentTag {
  id         String @id @default(uuid())
  documentId String
  tagId      String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([documentId, tagId])
  @@index([documentId])
  @@index([tagId])
}

model ActivityLog {
  id          String         @id @default(uuid())
  workspaceId String
  projectId   String?
  documentId  String?
  userId      String
  action      ActivityAction
  entityType  String
  metadata    String?
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

model WorkspaceSetting {
  id                 String   @id @default(uuid())
  workspaceId        String   @unique
  defaultStructure   String?
  themePreference    String   @default("light")
  companyName        String?
  website            String?
  industry           String?
  timezone           String?  @default("UTC")
  defaultVisibility  String?  @default("INTERNAL")
  notifyOnComment    Boolean  @default(true)
  notifyOnReview     Boolean  @default(true)
  emailNotifications Boolean  @default(true)
  inAppNotifications Boolean  @default(true)
  projectUpdates     Boolean  @default(true)
  taskAssignments    Boolean  @default(true)
  bugAlerts          Boolean  @default(true)
  releaseApprovals   Boolean  @default(true)
  securityAlerts     Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  type      String   @default("info")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

// ---------------------------------------------------------------------------
// CALENDAR & ENGINEERING SCHEDULE
// ---------------------------------------------------------------------------

model CalendarEvent {
  id          String   @id @default(uuid())
  workspaceId String
  projectId   String?
  title       String
  description String?
  eventType   String   @default("EVENT") // TASK_DEADLINE, SPRINT, RELEASE, MILESTONE, MEETING, DEPLOYMENT, REVIEW, EVENT
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean  @default(false)
  priority    String   @default("MEDIUM")
  color       String   @default("#3b82f6")
  location    String?
  meetingUrl  String?
  taskId      String?
  sprintId    String?
  milestoneId String?
  releaseId   String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  sprint    Sprint?    @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  release   Release?   @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([projectId])
  @@index([startDate])
}

// ---------------------------------------------------------------------------
// RFC SPECIFICATIONS & ARCHITECTURE DECISIONS
// ---------------------------------------------------------------------------

model RFC {
  id                        String                 @id @default(uuid())
  workspaceId               String
  projectId                 String?
  rfcNumber                 Int
  title                     String
  authorId                  String
  status                    String                 @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, ACCEPTED, REJECTED, SUPERSEDED, WITHDRAWN
  category                  String                 @default("ARCHITECTURE") // ARCHITECTURE, TECHNICAL_DESIGN, DATABASE_DESIGN, API_DESIGN, SECURITY, PERFORMANCE, INFRASTRUCTURE
  problemStatement          String
  motivation                String
  proposedSolution          String
  alternativeSolutions      String?
  technicalArchitecture     String?
  securityConsiderations    String?
  performanceConsiderations String?
  implementationPlan        String?
  migrationPlan             String?
  risks                     String?
  dependencies              String?
  reviewers                 String?                // JSON string of user IDs
  decisionDeadline          DateTime?
  version                   Int                    @default(1)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author     User                   @relation("RFCAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviews    RFCReview[]
  votes      RFCVote[]
  decisions  ArchitectureDecision[]

  @@unique([workspaceId, rfcNumber])
  @@index([workspaceId])
  @@index([projectId])
  @@index([authorId])
  @@index([status])
}

model RFCReview {
  id         String    @id @default(uuid())
  rfcId      String
  reviewerId String
  status     String    @default("PENDING") // PENDING, APPROVED, REQUEST_CHANGES, REJECTED
  comments   String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  rfc      RFC  @relation(fields: [rfcId], references: [id], onDelete: Cascade)
  reviewer User @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([rfcId])
  @@index([reviewerId])
}

model RFCVote {
  id        String   @id @default(uuid())
  rfcId     String
  voterId   String
  vote      String   // APPROVE, REJECT, ABSTAIN
  createdAt DateTime @default(now())

  rfc   RFC  @relation(fields: [rfcId], references: [id], onDelete: Cascade)
  voter User @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([rfcId, voterId])
  @@index([rfcId])
}

model ArchitectureDecision {
  id                     String    @id @default(uuid())
  workspaceId            String
  projectId              String?
  rfcId                  String?
  decisionNumber         Int
  title                  String
  status                 String    @default("ACCEPTED") // PROPOSED, ACCEPTED, SUPERSEDED, REJECTED
  context                String
  decision               String
  alternativesConsidered String?
  consequences           String
  approvedById           String
  approvedAt             DateTime  @default(now())
  documentId             String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rfc        RFC?      @relation(fields: [rfcId], references: [id], onDelete: SetNull)
  approvedBy User      @relation("DecisionApprover", fields: [approvedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, decisionNumber])
  @@index([workspaceId])
  @@index([projectId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// ENTERPRISE FILES & ASSET STORAGE
// ---------------------------------------------------------------------------

model FileFolder {
  id          String       @id @default(uuid())
  workspaceId String
  projectId   String?
  parentId    String?
  name        String
  color       String?      @default("#3b82f6")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    FileFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  FileFolder[] @relation("FolderHierarchy")
  files     FileItem[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([parentId])
}

model FileItem {
  id           String           @id @default(uuid())
  workspaceId  String
  projectId    String?
  folderId     String?
  uploaderId   String
  name         String
  originalName String
  mimeType     String
  extension    String
  sizeBytes    Int
  storagePath  String
  storageType  String           @default("LOCAL")
  version      Int              @default(1)
  isArchived   Boolean          @default(false)
  isDeleted    Boolean          @default(false)
  deletedAt    DateTime?
  documentId   String?
  taskId       String?
  bugId        String?
  rfcId        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder      FileFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploader    User             @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  versions    FileVersion[]
  attachments FileAttachment[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([folderId])
  @@index([uploaderId])
  @@index([isDeleted])
  @@index([mimeType])
}

model FileVersion {
  id            String   @id @default(uuid())
  fileId        String
  versionNumber Int
  sizeBytes     Int
  storagePath   String
  uploaderId    String
  changeNotes   String?
  createdAt     DateTime @default(now())

  file     FileItem @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploader User     @relation("FileVersionUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

model FileAttachment {
  id           String   @id @default(uuid())
  fileId       String
  entityType   String   // TASK, BUG, DOCUMENT, RFC, RELEASE, DISCUSSION
  entityId     String
  attachedById String
  createdAt    DateTime @default(now())

  file       FileItem @relation(fields: [fileId], references: [id], onDelete: Cascade)
  attachedBy User     @relation("FileAttacher", fields: [attachedById], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// WORKSPACE INVITATIONS & ACCESS CONTROL
// ---------------------------------------------------------------------------

model WorkspaceInvitation {
  id          String    @id @default(uuid())
  workspaceId String
  email       String
  role        UserRole  @default(EDITOR)
  invitedById String
  token       String    @unique
  status      String    @default("PENDING") // PENDING, ACCEPTED, EXPIRED, CANCELLED
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([token])
  @@index([status])
}
